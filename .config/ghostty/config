font-family = Monaspace Neon NF
font-feature = calt
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-size = 16
font-thicken = true

background = #101010
foreground = #ffffff
palette = 0=#101010
palette = 1=#f5a191
palette = 2=#90b99f
palette = 3=#e6b99d
palette = 4=#aca1cf
palette = 5=#e29eca
palette = 6=#ea83a5
palette = 7=#a0a0a0
palette = 8=#7e7e7e
palette = 9=#ff8080
palette = 10=#99ffe4
palette = 11=#ffc799
palette = 12=#b9aeda
palette = 13=#ecaad6
palette = 14=#f591b2
palette = 15=#ffffff

cursor-style = bar
cursor-style-blink = true

background-opacity = 0.8
background-blur = macos-glass-regular

window-width = 84
window-height = 28
window-padding-x = 4
window-padding-y = 6
window-colorspace = display-p3
title = Ghostty

mouse-hide-while-typing = true
macos-option-as-alt = false

shell-integration-features = ssh-env,ssh-terminfo
keybind = alt+backspace=text:\x1b\x7f
keybind = super+arrow_left=text:\x01
keybind = super+arrow_right=text:\x05
keybind = super+backspace=text:\x15
